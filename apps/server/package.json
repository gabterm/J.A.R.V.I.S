{
  "name": "@jarvis/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/index.js",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/websocket": "11.3.7",
    "@jarvis/protocol": "0.0.0",
    "fastify": "5.12.8",
    "openai": "7.65.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
