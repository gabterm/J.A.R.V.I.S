# Copie para .env (nunca commite o .env).
OPENAI_API_KEY=
# Modelo da OpenAI usado nas respostas.
OPENAI_MODEL=gpt-5.6-luna
# Voz (Realtime API): modelo e voz.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Postgres com pgvector. Local: docker compose up -d
DATABASE_URL=postgres://jarvis:jarvis-local@127.0.0.1:54329/jarvis
# Fuso da pessoa (data e hora no prompt).
TZ_PESSOA=America/Sao_Paulo
# Token do app. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JARVIS_TOKEN=
PORT=8787
